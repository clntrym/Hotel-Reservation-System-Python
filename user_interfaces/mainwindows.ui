                 <property name="styleSheet">
                  <string notr="true">QTableWidget {
    background-color: #ffffff;
    gridline-color: #ccc;
	border: none;
}

/* TABLE TEXT */
QTableWidget::item {
    color: #000000; /* solid black para siguradong kita */
}

/* SELECTED ROW */
QTableWidget::item:selected {
    background-color: #0a2b5c;
    color: #ffffff; /* readable kapag naka-select */
}

/* ALTERNATE ROWS */
QTableWidget::item:alternate {
    background-color: #f5f7fb;
}

/* HEADER */
QHeaderView::section {
    background-color: #0a2b5c;
    color: #ffcc00; /* hindi white */
    padding: 6px;
    font-weight: bold;
    border: 1px solid #ccc;
}

QTableWidget:hover {
    background-color: #EAF3FF;
    border: 2px solid #1E90FF;
}</string>
